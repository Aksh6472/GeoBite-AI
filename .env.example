# ---------------------------------------------------------------------------------
# GeoBite-AI environment template. Copy to `.env` (repo root, used by docker compose)
# and/or `backend/.env` (used when running the API directly). Never commit real values.
# ---------------------------------------------------------------------------------

# --- Database --------------------------------------------------------------------
# PostgreSQL + PostGIS (recommended). docker compose exposes the db on localhost:5433.
DATABASE_URL=postgresql+psycopg://geobite:geobite_dev_password@localhost:5433/geobite
# Quick SQLite fallback (no PostGIS; spatial queries fall back to Python haversine):
# DATABASE_URL=sqlite:///./geobite_dev.db
POSTGRES_PASSWORD=geobite_dev_password

# --- Security (REQUIRED in production) -------------------------------------------
ENVIRONMENT=development            # development | test | production
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480
IP_HASH_SALT=CHANGE-ME-generate-with-openssl-rand-hex-16
COOKIE_SECURE=false                # true when served over HTTPS
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=true                   # trust X-Forwarded-For; only if API is reachable solely via the web proxy

# --- Community portal protections ------------------------------------------------
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_15MIN=20
DEDUP_RADIUS_M=150
CLUSTER_WINDOW_DAYS=30
DUPLICATE_WINDOW_HOURS=48

# --- Privacy & retention ---------------------------------------------------------
PUBLIC_MIN_CELL_COUNT=3            # small-cell suppression threshold on public aggregates
PUBLIC_GRID_DEG=0.005              # ~550 m snapping grid for public community layers
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
RETENTION_PHOTO_DAYS=365
RETENTION_IP_HASH_DAYS=30

# --- Optional AI modules ---------------------------------------------------------
ENABLE_YOLO=0                      # 1 to enable dog detection (pip install -r backend/requirements-ml.txt)
YOLO_WEIGHTS=yolov8n.pt

# --- Docker compose --------------------------------------------------------------
SEED_ON_START=true                 # seed synthetic demo data on first start (idempotent)

# --- Frontend (frontend/.env.local) ----------------------------------------------
# API_INTERNAL_URL=http://localhost:8010   # where Next.js proxies /api/* to
